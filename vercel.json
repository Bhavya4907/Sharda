{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "main.py"
    }
  },
  "rewrites": [
    {
      "source": "/upload/:path*",
      "destination": {
        "type": "service",
        "service": "backend",
        "endpoint": "/upload/:path*"
      }
    },
    {
      "source": "/session/:path*",
      "destination": {
        "type": "service",
        "service": "backend",
        "endpoint": "/session/:path*"
      }
    },
    {
      "source": "/health",
      "destination": {
        "type": "service",
        "service": "backend",
        "endpoint": "/health"
      }
    },
    {
      "source": "/api-backend/:path*",
      "destination": {
        "type": "service",
        "service": "backend",
        "endpoint": "/:path*"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
